# local | production. Production forces APP_DEBUG=0 and ALLOW_PRIVATE_HOSTS=0 whatever is set below.
APP_ENV=local
APP_NAME=CaliChat
APP_URL=http://localhost/calichat
# Legacy single key (still read). Prefer APP_KEYS for rotation: "k2:<64 hex>,k1:<64 hex>" (first = current).
APP_KEY=
APP_KEYS=
APP_DEBUG=0
# Set to 1 only behind a reverse proxy you control (trusts X-Forwarded-For / -Proto).
TRUST_PROXY=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=calichat_ai
# Use a dedicated least-privilege user in production, never root.
DB_USER=root
DB_PASS=

# Gemini (platform default key; tenants may override in Settings)
GEMINI_API_KEY=
# 1 = never call Gemini (kill switch; the automated tests set it)
GEMINI_DISABLED=0
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=256
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
# Optional: minimal|low|medium|high (leave empty to omit)
GEMINI_THINKING=
GEMINI_MAX_OUTPUT=4096
GEMINI_TIMEOUT=20
AGENT_DEADLINE=40
GEMINI_GLOBAL_RPM=600
# Prices per 1M tokens, used only for the cost estimates in monitoring. Set these to your plan's real rates.
GEMINI_PRICE_IN_PER_M=0.10
GEMINI_PRICE_OUT_PER_M=0.40

META_GRAPH_VERSION=v21.0

# Local development only (forced off when APP_ENV=production)
ALLOW_PRIVATE_HOSTS=1

# 1 = if no queue worker daemon is running, the webhook processes a few messages inline after replying 200
QUEUE_INLINE_DRAIN=1
INBOUND_PER_MIN=600
CAMPAIGN_BATCH=30

# Memory: mysql (built-in) or tencentdb (sidecar HTTP service)
MEMORY_PROVIDER=mysql
TENCENT_MEMORY_URL=http://127.0.0.1:8080
TENCENT_MEMORY_TOKEN=
TENCENT_TOOL_RECALL=memory_recall
TENCENT_TOOL_CAPTURE=memory_capture

# Alert e-mails use PHP mail(); enable only when the server can send mail
MAIL_ENABLED=0
MAIL_FROM=noreply@localhost

# Secret for cron/worker.php over HTTP
CRON_KEY=

# --- Billing (self sign-up trial and grace period)
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=3

# --- Voice-note replies (needs ffmpeg; leave FFMPEG_PATH empty to search the PATH)
FFMPEG_PATH=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
